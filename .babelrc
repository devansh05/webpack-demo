{
  "presets": ["@babel/preset-typescript"],
  "env": {
    "production": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "useBuiltIns": "usage",
            "corejs": {
              "version": 3,
              "proposals": true
            },
            "debug": true
          }
        ]
      ],
      "plugins": [
        ["@babel/plugin-proposal-pipeline-operator", { "proposal": "minimal" }]
      ]
    },
    "development": {
      "presets": ["@babel/preset-env"],
      "plugins": [
        ["@babel/plugin-proposal-pipeline-operator", { "proposal": "minimal" }]
      ]
    }
  }
}
